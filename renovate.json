{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":dependencyDashboard"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "renovate"
  ],
  "prConcurrentLimit": 5,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images used with docker run in workflows (image:tag@sha256:digest)",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9./_-]*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Container images in Ansible role defaults (<role>_..._image: image:tag@sha256:digest), e.g. the docs build image",
      "managerFilePatterns": [
        "/^hosts/roles/[^/]+/defaults/main\\.ya?ml$/"
      ],
      "matchStrings": [
        "_image: \"?(?<depName>[a-z0-9][a-z0-9./_-]*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})\"?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "DefenseClaw release behind the observe stack's dashboards and rules",
      "managerFilePatterns": [
        "/^hosts/stacks/observe/defenseclaw-bundle\\.yaml$/"
      ],
      "matchStrings": [
        "version: \"(?<currentValue>[^\"]+)\"\\s+# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "dcgm-exporter 4.9 renames the metrics and changes units (DCGM 4.7 names); the vmalert rules and dashboards use the 4.8 names. Lift when they move",
      "matchDepNames": [
        "nvcr.io/nvidia/k8s/dcgm-exporter"
      ],
      "allowedVersions": "<4.9.0"
    },
    {
      "description": "Group CI scanner tools into one PR",
      "matchFileNames": [
        ".github/**"
      ],
      "groupName": "CI tools"
    },
    {
      "description": "DefenseClaw bump needs `defenseclaw-bundle.py sync` on dgx-1 before merge",
      "matchDepNames": [
        "cisco-ai-defense/defenseclaw"
      ],
      "automerge": false,
      "prBodyNotes": [
        "Run `.github/scripts/defenseclaw-bundle.py sync` on dgx-1, port any printed diffs, push to this branch."
      ]
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^\\.github/requirements-(ci|aibom|radar)\\.txt$/",
      "/^docs-site/requirements-docs\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  }
}
