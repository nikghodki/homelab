# The *.nghodki.ai front door in k3s (decision 0007, runbooks/edge.md). Backends are reached directly; since
# 2026-11-15 there's no relay through dgx-1's edge-caddy/nginx-gateway (both stopped, decision 0007 "Relay retired").
#   - LiteLLM and DGXMM on dgx-1 by its direct-cable address 10.100.136.1 (reachable from both Sparks, where these
#     pods run, but not on the LAN or the tailnet). DGXMM publishes :8090 only there and trusts X-Forwarded-For from
#     the two source addresses these pods arrive with: 10.100.136.2 (pod on dgx-2) and 172.23.0.1 (pod on dgx-1,
#     masqueraded onto the Docker network `gateway`); DGXMM_TRUSTED_PROXIES in its .env.
#   - Home Assistant on the Jetson trusts X-Forwarded-For from both Sparks' LAN IPs (the pods leave from their node's IP).
#   - Argo CD by its Service name.
#   - The wildcard cert is the TLS Secret `web-tls` (KSOPS); the CA page is a ConfigMap of hosts/files/web-ca.
# Served on :80 and on :443 with the homelab web CA's wildcard (runbooks/web-https.md).
{
	grace_period 10s
}

# The model plane, as nginx-gateway served it (model.nghodki.ai, also dgxmanager.nghodki.ai and the door by IP,
# which were nginx's default server): LiteLLM's /v1/ and /health*, DGXMM's UI and API under /dgxmm/.
(model_plane) {
	# nginx redirected the bare prefixes to the slashed ones
	redir /v1 /v1/ 301
	redir /dgxmm /dgxmm/ 301
	# DGXMM's on-demand gateway is for LiteLLM on the Docker network only.
	handle /dgxmm/ondemand/* {
		respond 404
	}
	# DGX Model Manager: SSE, so no buffering; long reads; DGXMM's own 1 MB request limit (deploy/nginx-dgxmm.conf).
	handle /dgxmm/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy 10.100.136.1:8090 {
			header_up X-Real-IP {remote_host}
			flush_interval -1
			transport http {
				read_timeout 1h
			}
		}
	}
	# LiteLLM. On-demand models: a cold start or queued request can wait several minutes; stream without buffering.
	@litellm path /v1/* /health*
	handle @litellm {
		reverse_proxy 10.100.136.1:4000 {
			header_up X-Real-IP {remote_host}
			flush_interval -1
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}
	handle {
		header Content-Type application/json
		respond `{"error": "Use /v1/ for LLM requests"}` 404
	}
}

# Sign-in for apps without their own login (decision 0011, runbooks/sign-in.md): one oauth2-proxy, edge-auth, for
# every name. `import signed_in <backend> <group>` is the whole route: http -> https, the session check (edge-auth's
# /oauth2/auth?allowed_groups=<group>), then the backend with the edge origin token (the backends refuse requests
# without it) and without the session cookie. Signed out, edge-auth's /oauth2/start answers here: a CSRF cookie and a
# 302 to Pocket ID; after the passkey the browser comes back through https://auth.nghodki.ai/oauth2/callback to the
# URL it asked for. The cookie is for .nghodki.ai, so one sign-in covers every signed-in route.
(signed_in) {
	@plain protocol http
	redir @plain https://{host}{uri} 308
	reverse_proxy edge-auth.edge.svc.cluster.local:4180 {
		# forward auth, written out (forward_auth can't pass the refreshed session cookie back to the browser)
		method GET
		rewrite /oauth2/auth?allowed_groups={args[1]}
		header_up X-Forwarded-Method {method}
		header_up X-Forwarded-Uri {uri}
		@ok status 2xx
		handle_response @ok {
			copy_response_headers {
				include Set-Cookie
			}
		}
		@signin status 401
		handle_response @signin {
			reverse_proxy edge-auth.edge.svc.cluster.local:4180 {
				method GET
				rewrite /oauth2/start?
				header_up X-Forwarded-Uri {http.request.orig_uri}
			}
		}
		# anything else (403: signed in, not in the group; 5xx: edge-auth down) goes back to the browser as it is
	}
	reverse_proxy {args[0]} {
		header_up X-Edge-Origin {env.EDGE_ORIGIN_TOKEN}
		header_up Cookie "_edge_auth[^;]*(;\s*)?" ""
	}
}

(nghodki_routes) {
	# Pocket ID (dgx-2, console stack). Passkeys need HTTPS, so http is redirected.
	@id host id.nghodki.ai
	handle @id {
		@plain protocol http
		redir @plain https://{host}{uri} 308
		reverse_proxy 192.168.86.36:1411
	}

	# Homepage launcher (Dell ops stack) behind oauth2-proxy + Pocket ID. Session cookies are Secure, so http is redirected.
	@ops host ops.nghodki.ai
	handle @ops {
		@plain protocol http
		redir @plain https://{host}{uri} 308
		reverse_proxy 192.168.86.49:4180
	}

	# Sign-in (decision 0011): edge-auth's callback, sign-out (/oauth2/sign_out) and probe. Anything else goes to Homepage.
	@auth host auth.nghodki.ai
	handle @auth {
		@plain protocol http
		redir @plain https://{host}{uri} 308
		@proxy path /oauth2/* /ping
		handle @proxy {
			reverse_proxy edge-auth.edge.svc.cluster.local:4180
		}
		handle {
			redir https://ops.nghodki.ai/ 302
		}
	}

	# Private docs site (Dell ops stack, runbooks/docs-site.md): the docs Caddy's gate on :4181.
	@docs host docs.nghodki.ai
	handle @docs {
		import signed_in 192.168.86.49:4181 admins
	}

	@ca host ca.nghodki.ai
	handle @ca {
		root * /etc/caddy/ca
		header /*.mobileconfig Content-Type application/x-apple-aspen-config
		header /*.crt Content-Type application/x-x509-ca-cert
		file_server {
			# the ConfigMap volume's ..data symlinks
			hide ..*
		}
	}

	@model host model.nghodki.ai
	handle @model {
		import model_plane
	}

	# Observability on dgx-2
	@grafana host grafana.nghodki.ai
	handle @grafana {
		reverse_proxy 192.168.86.36:3000
	}

	# Gatus and ntfy run on the Dell (hosts/stacks/alerting, runbooks/alerting.md).
	@status host status.nghodki.ai
	handle @status {
		reverse_proxy 192.168.86.49:8081
	}

	@ntfy host ntfy.nghodki.ai
	handle @ntfy {
		reverse_proxy 192.168.86.49:8085 {
			flush_interval -1
		}
	}

	@phoenix host phoenix.nghodki.ai
	handle @phoenix {
		reverse_proxy 192.168.86.36:6006
	}

	# MLflow (dgx-2 ml stack) behind oauth2-proxy. Its session cookies are Secure, so http is redirected.
	@mlflow host mlflow.nghodki.ai
	handle @mlflow {
		@plain protocol http
		redir @plain https://{host}{uri} 308
		reverse_proxy 192.168.86.36:4181
	}

	# Temporal Web UI (dgx-2 jobs stack), Pocket ID sign-in. Its session cookies are Secure, so http is redirected.
	@temporal host temporal.nghodki.ai
	handle @temporal {
		@plain protocol http
		redir @plain https://{host}{uri} 308
		reverse_proxy 192.168.86.36:8233
	}

	# Argo CD (runbooks/argocd.md): the server runs insecure; TLS ends here.
	@argocd host argocd.nghodki.ai
	handle @argocd {
		@plain protocol http
		redir @plain https://{host}{uri} 308
		reverse_proxy argocd-server.argocd.svc.cluster.local:80 {
			flush_interval -1
		}
	}

	@admin host litellm-admin.nghodki.ai
	handle @admin {
		reverse_proxy 100.65.137.82:4000 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	@control host controlcenter.nghodki.ai
	handle @control {
		# RoboClaw Control Center on the Jetson (uvicorn :8200)
		reverse_proxy 192.168.86.211:8200
	}

	# DGXMM's UI by name. The rest of the model plane (LiteLLM's /v1/) answers here too, as it did on nginx-gateway.
	@dgxmm host dgxmanager.nghodki.ai
	handle @dgxmm {
		redir / /dgxmm/ 302
		import model_plane
	}

	# Home Assistant on the Jetson (websockets; Caddy has no read timeout by default).
	@ha host ha.nghodki.ai
	handle @ha {
		reverse_proxy 192.168.86.211:8123 {
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}

	@webui host webui.nghodki.ai
	handle @webui {
		reverse_proxy 100.65.137.82:3100 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			# chat replies stream; on-demand models can cold-start for minutes
			flush_interval -1
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}

	# Anything else (the front door by IP, an unknown name): the model plane, as nginx-gateway's default server did.
	handle {
		import model_plane
	}
}

:80 {
	import nghodki_routes
}

:443 {
	tls /etc/caddy/certs/tls.crt /etc/caddy/certs/tls.key
	import nghodki_routes
}

# Probes (pod-internal).
:8081 {
	respond /healthz "ok" 200
}
