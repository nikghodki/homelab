# Managed by homelab Ansible (role ros_lidar). ROS 2 over Zenoh via the Jetson router.
RMW_IMPLEMENTATION=rmw_zenoh_cpp
# The env's default session config with keys its libzenohc rejects removed (see the role's tasks).
ZENOH_SESSION_CONFIG_URI={{ ros_lidar_config_dir }}/zenoh-session.json5
# Client mode: every message goes through the router. In peer mode the Jetson never saw the Pi's
# topics (the peers only advertise localhost locators); runbooks/robot-ros.md.
ZENOH_CONFIG_OVERRIDE='mode="client";connect/endpoints=["{{ ros_lidar_zenoh_router }}"]'
