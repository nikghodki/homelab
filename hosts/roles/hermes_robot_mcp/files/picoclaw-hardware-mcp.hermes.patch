+// Latch the governor's e-stop over NATS (MQTT topic robot/pi/safety/estop). Any payload latches.
+function publishEstop() {
+  return new Promise((resolve, reject) => {
+    if (!mqttConnected || !mqttClient) {
+      reject(new Error("not connected to MQTT/NATS"));
+      return;
+    }
+    const payload = JSON.stringify({ source: "hermes", tool: "stop", at: new Date().toISOString() });
+    mqttClient.publish(ESTOP_TOPIC, payload, { qos: 1 }, (err) => {
+      if (err) reject(new Error(`e-stop publish failed: ${err.message}`));
+      else resolve({ latched_via: ESTOP_TOPIC });
+    });
+  });
 }
 
