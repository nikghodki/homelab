+// ---------------------------------------------------------------------------
+// Motion: only through PicoClaw on the Pi, whose MCP tools go through the safety governor
+// ---------------------------------------------------------------------------
+// One structured request per call, on the same MQTT topic as send_to_picoclaw_agent. The first line is
+// machine-readable; the rest tells PicoClaw what to do with it.
+function motionMessage(toolName, args) {
+  const clean = Object.fromEntries(Object.entries(args || {}).filter(([, v]) => v !== undefined));
+  return `[hermes-motion v1] ${JSON.stringify({ tool: toolName, arguments: clean })}\n` +
+    `Hermes asks you to move the robot. Call your own \`${toolName}\` tool exactly once with exactly these ` +
+    "arguments; it goes through the robot's safety governor. Don't call any other motion tool and don't retry. " +
+    'Reply with one line of JSON only: {"ok": true, "result": <the tool result>} or {"ok": false, "error": "<why>"}.';
+}
 
-async function doTurn(direction, degrees) {
-  if (degrees < 8) return { skipped: true, degrees };
-  const r = await post("/turn", { direction, degrees });
-  await sleep(turnWait(degrees));
-  return r;
+function parseReply(text) {
+  const s = String(text ?? "");
+  const start = s.indexOf("{");
+  const end = s.lastIndexOf("}");
+  if (start < 0 || end <= start) return null;
+  try { return JSON.parse(s.slice(start, end + 1)); } catch { return null; }
+}
+
+async function viaPicoclaw(toolName, args, timeoutSeconds = MOTION_TIMEOUT_S) {
+  const r = await askPicoclaw(motionMessage(toolName, args), timeoutSeconds);
+  if (r.status === "timeout") {
+    throw new Error(`PicoClaw did not answer the ${toolName} request within ${timeoutSeconds}s ` +
+      "(the safety governor stops the robot when a move ends or its heartbeat stops)");
+  }
+  const reply = parseReply(r.response);
+  if (reply && reply.ok === false) {
+    throw new Error(`PicoClaw/safety governor refused ${toolName}: ${typeof reply.error === "string" ? reply.error : JSON.stringify(reply)}`);
+  }
+  return { via: "picoclaw (safety governor)", tool: toolName, ...(reply ? { result: reply.result ?? reply } : { response: r.response }) };
 }
 
