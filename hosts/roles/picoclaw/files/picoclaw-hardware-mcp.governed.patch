+// A refused request or a hard stop (e-stop, governor fault, no governor) ends the whole task.
+// An obstacle doesn't: the caller scans and turns away, as before.
+function governed(r) {
+  if (r.error) throw new Error(`motion bridge refused the move: ${r.error}`);
+  if (hardStop(r)) {
+    throw new Error(`safety governor blocked the move: ${r.blocked_reason} ` +
+      `(${JSON.stringify(r.governor_states || r.governor || {})})`);
+  }
+  return r;
+}
 
+// The drive/turn tools report any block (an obstacle too) as a tool error, with the governor's answer.
+function mustMove(r) {
+  governed(r);
+  if (r.blocked) throw new Error(`safety governor blocked the move: ${r.blocked_reason}: ${JSON.stringify(r)}`);
+  return r;
+}
+
+// The bridge answers when the move has ended, so there's no extra wait (the car's API returned at once).
