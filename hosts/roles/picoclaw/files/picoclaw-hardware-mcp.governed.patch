+async function driveChunk(speed, ms, direction = "forward") {
+  return governed(await motion.drive({ direction, speed, duration_ms: ms }));
+}
+
+// End of a task: zero command through the governor (no e-stop latch), then the car's own /stop too.
+async function endTask() {
+  const out = {};
+  try { out.governor = await motion.halt(); } catch (e) { out.governor = { error: e.message }; }
+  try { out.car = await post("/stop"); } catch (e) { out.car = { error: e.message }; }
+  return out;
 }
 
