# Managed by homelab Ansible (role edge_connector). Secrets from secrets/fleet.enc.yaml.
DCLAW_TENANT_ID={{ edge_connector_tenant_id }}
DCLAW_FLEET_ID={{ edge_connector_fleet_id }}
DCLAW_DEVICE_ID={{ edge_connector_device_id }}
DCLAW_BROKER_URL={{ edge_connector_broker_url }}
DCLAW_CA_CERT_PATH={{ edge_connector_ca_cert }}
DCLAW_MQTT_USER=dclaw-device-{{ edge_connector_key_suffix | replace('_', '-') }}
DCLAW_MQTT_PASS={{ edge_connector_secrets['mosquitto_dclaw_device_' ~ edge_connector_key_suffix ~ '_password'] }}
DCLAW_OTA_HMAC_KEY={{ edge_connector_secrets.dclaw_ota_hmac_key }}
DCLAW_EMERGENCY_KEY={{ edge_connector_secrets.dclaw_emergency_key }}
DCLAW_AUDIT_KEY={{ edge_connector_secrets['dclaw_audit_key_' ~ inventory_hostname] }}
DCLAW_IPC_ALLOWED_UID={{ edge_connector_ipc_uid }}
DCLAW_IPC_ALLOWED_GID={{ edge_connector_ipc_gid }}
DCLAW_STRICT_MODE={{ edge_connector_strict_mode }}
DCLAW_LOG_LEVEL={{ edge_connector_log_level }}
