#!/bin/sh
# Managed by homelab Ansible (role safety_governor). E-stop over NATS: runbooks/robot-safety.md.
#   safety-estop | safety-estop status   (as picoclaw, which may latch but not clear it)
#   safety-estop reset                   runs safety-reset (as operator)
if [ "$1" = reset ]; then
  shift
  exec "{{ safety_governor_home }}/.local/bin/safety-reset" "$@"
fi
export PYTHONPATH="{{ safety_governor_code_dir }}"
exec "{{ safety_governor_micromamba }}" run -p "{{ safety_governor_env }}" python -m safety_governor.estop_cli "$@"
