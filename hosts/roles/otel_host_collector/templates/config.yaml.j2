# Managed by homelab Ansible (roles/otel_host_collector)
receivers:
  hostmetrics:
    collection_interval: 30s
    scrapers:
      cpu: {}
      load: {}
      # MemAvailable as system.linux.memory.available (vmalert FleetMemoryLow on GB10)
      memory: {metrics: {system.linux.memory.available: {enabled: true}}}
      paging: {}
      network: {}
      processes: {}
      disk: {}
      filesystem:
        exclude_fs_types:
          fs_types: [tmpfs, devtmpfs, overlay, squashfs, nsfs, autofs, efivarfs, proc, sysfs, cgroup2, fuse.portal, tracefs, debugfs, securityfs, pstore, bpf, configfs, binfmt_misc, mqueue, hugetlbfs, ramfs, fusectl]
          match_type: strict
  journald:
    priority: info
{% if otel_host_collector_scrape_fleet_metrics %}
  prometheus/fleet-metrics:
    config:
      scrape_configs:
        - job_name: fleet-metrics
          scrape_interval: 30s
          metrics_path: /metrics/prometheus
          static_configs:
            - targets: ["127.0.0.1:{{ otel_host_collector_fleet_metrics_port }}"]
{% endif %}
{% if otel_host_collector_extra_scrapes | length > 0 %}
  prometheus/extra:
    config:
      scrape_configs:
{% for s in otel_host_collector_extra_scrapes %}
        - job_name: {{ s.job }}
          scrape_interval: {{ s.interval | default('30s') }}
          metrics_path: {{ s.path | default('/metrics') }}
{% if s.bearer_token_file is defined %}
          authorization:
            type: Bearer
            credentials_file: {{ s.bearer_token_file }}
{% endif %}
          static_configs:
            - targets: ["{{ s.target }}"]
{% endfor %}
{% endif %}
{% for p in otel_host_collector_pod_logs %}
  # k3s pod logs ({{ p.namespace }}/{{ p.pod_prefix }}, container {{ p.container }}): the CRI log lines, unwrapped. The
  # body stays the app's own line (JSON for Caddy, so LogQL's `| json` works); k8s.* come from the file path.
  filelog/{{ p.service }}:
    include: ["/var/log/pods/{{ p.namespace }}_{{ p.pod_prefix }}-*/{{ p.container }}/*.log"]
    include_file_path: true
    start_at: end
    storage: file_storage
    operators:
      - {type: container, add_metadata_from_filepath: true}
{% endfor %}
processors:
  memory_limiter: {check_interval: 2s, limit_percentage: 80, spike_limit_percentage: 20}
  resourcedetection:
    detectors: [system]
    system: {hostname_sources: [os]}
  resource:
    attributes:
      - {key: fleet.host, value: "{{ inventory_hostname }}", action: upsert}
{% for p in otel_host_collector_pod_logs %}
  resource/{{ p.service }}:
    attributes:
      - {key: service.name, value: "{{ p.service }}", action: upsert}
{% endfor %}
  batch: {timeout: 10s}
exporters:
  otlp:
    endpoint: "{{ otel_host_collector_endpoint }}"
    tls: {insecure: true}
    sending_queue: {enabled: true, queue_size: 2000}
    retry_on_failure: {enabled: true, max_elapsed_time: 30m}
{% if otel_host_collector_pod_logs | length > 0 %}
extensions:
  # Read offsets of the pod log files, so a restart neither skips nor repeats lines.
  file_storage: {directory: /var/lib/otelcol-contrib}
{% endif %}
service:
{% if otel_host_collector_pod_logs | length > 0 %}
  extensions: [file_storage]
{% endif %}
  telemetry:
    metrics: {level: none}
  pipelines:
    metrics:
      receivers: [hostmetrics{% if otel_host_collector_scrape_fleet_metrics %}, prometheus/fleet-metrics{% endif %}{% if otel_host_collector_extra_scrapes | length > 0 %}, prometheus/extra{% endif %}]
      processors: [memory_limiter, resourcedetection, resource, batch]
      exporters: [otlp]
    logs:
      receivers: [journald]
      processors: [memory_limiter, resourcedetection, resource, batch]
      exporters: [otlp]
{% for p in otel_host_collector_pod_logs %}
    logs/{{ p.service }}:
      receivers: [filelog/{{ p.service }}]
      processors: [memory_limiter, resourcedetection, resource, resource/{{ p.service }}, batch]
      exporters: [otlp]
{% endfor %}
