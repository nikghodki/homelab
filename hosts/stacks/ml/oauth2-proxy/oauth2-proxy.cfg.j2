# oauth2-proxy for https://mlflow.nghodki.ai (plan P6.5). Rendered 0600 for uid 65532 (the image user).
# Recipe: runbooks/sign-in.md ("Apps without their own login").
http_address = "0.0.0.0:4180"
reverse_proxy = true
# only the front door (dgx-1 edge-caddy) may set X-Forwarded-*
trusted_proxy_ips = ["192.168.86.44/32"]
upstreams = ["http://mlflow:5000"]

provider = "oidc"
provider_display_name = "Pocket ID"
oidc_issuer_url = "https://id.nghodki.ai"
client_id = "mlflow"
client_secret = "{{ console_secrets.oidc_mlflow_secret }}"
redirect_url = "https://mlflow.nghodki.ai/oauth2/callback"
code_challenge_method = "S256"
scope = "openid email profile groups"
oidc_groups_claim = "groups"
allowed_groups = ["admins"]
email_domains = ["*"]
skip_provider_button = true

cookie_name = "_mlflow_oauth2_proxy"
cookie_secret = "{{ ml_secrets.oauth2_proxy_mlflow_cookie_secret }}"
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
cookie_domains = ["mlflow.nghodki.ai"]
cookie_expire = "168h"
cookie_refresh = "1h"

pass_host_header = true
