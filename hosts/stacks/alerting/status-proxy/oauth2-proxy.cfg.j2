# oauth2-proxy in front of Gatus for https://status.nghodki.ai (runbooks/alerting.md). Rendered 0600 for uid 65532.
# Gatus' own OIDC panics at start when Pocket ID (dgx-2, through dgx-1) can't be reached, which would stop all checks
# exactly when the Sparks are down; so Gatus has no login and this proxy does the sign-in. If Pocket ID is down only
# the status page is unavailable; the checks and alerts keep running.
http_address = "0.0.0.0:4180"
reverse_proxy = true
# only the front door (dgx-1 edge-caddy) may set X-Forwarded-*
trusted_proxy_ips = ["192.168.86.44/32"]
upstreams = ["http://gatus:8080"]
# No session needed: health checks, VictoriaMetrics' scrape, and Alertmanager's heartbeat (Gatus checks its token).
skip_auth_routes = ["GET=^/health$", "GET=^/metrics$", "POST=^/api/v1/endpoints/[^/]+/external$"]

provider = "oidc"
provider_display_name = "Pocket ID"
oidc_issuer_url = "https://id.nghodki.ai"
# Pocket ID's existing `gatus` client (callback /authorization-code/callback, no PKCE), so the prefix matches it.
proxy_prefix = "/authorization-code"
client_id = "gatus"
client_secret = "{{ oidc_gatus_secret }}"
redirect_url = "https://status.nghodki.ai/authorization-code/callback"
scope = "openid email profile groups"
oidc_groups_claim = "groups"
allowed_groups = ["admins"]
email_domains = ["*"]
skip_provider_button = true

cookie_name = "_status_oauth2_proxy"
cookie_secret = "{{ oauth2_proxy_status_cookie_secret }}"
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
cookie_domains = ["status.nghodki.ai"]
cookie_expire = "168h"
cookie_refresh = "1h"

pass_host_header = true
