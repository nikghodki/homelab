# Static docs server (stacks/ops service `docs`, runbooks/docs-site.md). Plain HTTP on the stack network only;
# oauth2-proxy-docs is in front. The site is /srv/docs/current (a symlink that docs-build swaps atomically).
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	# Homepage's siteMonitor; no file access
	handle /healthz {
		respond "ok" 200
	}
	handle {
		root * /srv/docs/current
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy same-origin
			X-Frame-Options DENY
			# Everything the site loads is its own (system fonts, local Mermaid and search); Material uses inline scripts.
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			-Server
		}
		file_server
	}
	handle_errors 404 {
		root * /srv/docs/current
		rewrite * /404.html
		file_server
	}
}
