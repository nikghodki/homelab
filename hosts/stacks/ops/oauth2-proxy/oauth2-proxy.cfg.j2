# oauth2-proxy for https://ops.nghodki.ai (plan P1.15), on the Dell (stacks/ops). Rendered 0600 for uid 65532 (the image user).
# Pattern for putting any app without its own OIDC behind Pocket ID: runbooks/sign-in.md.
http_address = "0.0.0.0:4180"
reverse_proxy = true
# only the front door (dgx-1 edge-caddy) may set X-Forwarded-*
trusted_proxy_ips = ["192.168.86.44/32"]
upstreams = ["http://homepage:3000"]

provider = "oidc"
provider_display_name = "Pocket ID"
oidc_issuer_url = "https://id.nghodki.ai"
client_id = "ops"
client_secret = "{{ oidc_ops_secret }}"
redirect_url = "https://ops.nghodki.ai/oauth2/callback"
code_challenge_method = "S256"
scope = "openid email profile groups"
oidc_groups_claim = "groups"
allowed_groups = ["admins"]
email_domains = ["*"]
skip_provider_button = true

cookie_name = "_ops_oauth2_proxy"
cookie_secret = "{{ oauth2_proxy_ops_cookie_secret }}"
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
cookie_domains = ["ops.nghodki.ai"]
cookie_expire = "168h"
cookie_refresh = "1h"

pass_host_header = true
