# Rendered by Ansible (password from SOPS). All alerts go to ntfy topic "fleet-alerts" on the Dell (stacks/alerting,
# runbooks/alerting.md), over the LAN so neither the front door nor Tailscale is in the path; Hermes/WhatsApp is added later.
# The always-firing Watchdog goes to the Dell's Gatus instead, as a heartbeat (Gatus alerts when it stops).
route:
  receiver: ntfy
  group_by: [alertname, host_name]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers: ['alertname="Watchdog"']
      receiver: gatus-heartbeat
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 5m
    - matchers: ['severity="critical"']
      receiver: ntfy-critical
      repeat_interval: 30m
receivers:
  - name: ntfy
    webhook_configs:
      - url: http://192.168.86.49:8085/fleet-alerts?template=alertmanager
        send_resolved: true
        http_config:
          basic_auth: {username: alerts, password: "{{ ntfy_alerts_password }}"}
  - name: ntfy-critical
    webhook_configs:
      - url: http://192.168.86.49:8085/fleet-alerts?template=alertmanager&priority=urgent
        send_resolved: true
        http_config:
          basic_auth: {username: alerts, password: "{{ ntfy_alerts_password }}"}
  - name: gatus-heartbeat
    webhook_configs:
      - url: http://192.168.86.49:8081/api/v1/endpoints/observe_alert-pipeline-heartbeat/external?success=true
        send_resolved: false
        http_config:
          authorization: {credentials: "{{ gatus_heartbeat_token }}"}
inhibit_rules:
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: [alertname, host_name]
