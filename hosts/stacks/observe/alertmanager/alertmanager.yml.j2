# Rendered by Ansible (password from SOPS). All alerts go to ntfy topic "fleet-alerts" on the Dell (stacks/alerting,
# runbooks/alerting.md), over the LAN so neither the front door nor Tailscale is in the path; Hermes/WhatsApp is added later.
# The always-firing Watchdog goes to the Dell's Gatus instead, as a heartbeat (Gatus alerts when it stops).
# The dead man for the Dell itself (vmalert/rules/alerting-host.yml) can't use the Dell: it goes to public ntfy.sh on
# a random topic (SOPS ntfy_sh_backup_topic_token) with a fixed, content-free text (ntfy's template mode renders
# only the m/t parameters; the body has no hostnames or addresses).
route:
  receiver: ntfy
  group_by: [alertname, host_name]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers: ['alertname="AlertingHostDown"']
      receiver: ntfy-sh-backup-host
      group_wait: 0s
      repeat_interval: 4h
    - matchers: ['alertname="AlertDeliveryFailing"']
      receiver: ntfy-sh-backup-delivery
      repeat_interval: 4h
    - matchers: ['alertname="Watchdog"']
      receiver: gatus-heartbeat
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 5m
    # Copies of checks that Gatus on the Dell already pushes (paging="false" in the vmalert rules): one push per
    # outage. They stay visible in Alertmanager and Grafana.
    - matchers: ['paging="false"']
      receiver: no-push
    - matchers: ['severity="critical"']
      receiver: ntfy-critical
      repeat_interval: 30m
receivers:
  - name: no-push
  - name: ntfy
    webhook_configs:
      - url: http://192.168.86.49:8085/fleet-alerts?template=alertmanager
        send_resolved: true
        http_config:
          basic_auth: {username: alerts, password: "{{ ntfy_alerts_password }}"}
  - name: ntfy-critical
    webhook_configs:
      - url: http://192.168.86.49:8085/fleet-alerts?template=alertmanager&priority=urgent
        send_resolved: true
        http_config:
          basic_auth: {username: alerts, password: "{{ ntfy_alerts_password }}"}
  - name: gatus-heartbeat
    webhook_configs:
      - url: http://192.168.86.49:8081/api/v1/endpoints/observe_alert-pipeline-heartbeat/external?success=true
        send_resolved: false
        http_config:
          authorization: {credentials: "{{ gatus_heartbeat_token }}"}
  - name: ntfy-sh-backup-host
    webhook_configs:
      - url: "https://ntfy.sh/{{ ntfy_sh_backup_topic }}?tpl=1&p=urgent&tags=rotating_light&t=homelab&m=homelab%3A%20alerting%20host%20unreachable"
        send_resolved: false
  - name: ntfy-sh-backup-delivery
    webhook_configs:
      - url: "https://ntfy.sh/{{ ntfy_sh_backup_topic }}?tpl=1&p=high&tags=warning&t=homelab&m=homelab%3A%20alert%20delivery%20failing"
        send_resolved: false
inhibit_rules:
  # Gatus already pushed "<host> ssh" down: no second push from FleetHostSilent for the same host.
  - source_matchers: ['alertname="GatusHostDown"']
    target_matchers: ['alertname="FleetHostSilent"']
    equal: [fleet_host]
  - source_matchers: ['alertname="AlertingHostDown"']
    target_matchers: ['alertname="AlertDeliveryFailing"']
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: [alertname, host_name]
