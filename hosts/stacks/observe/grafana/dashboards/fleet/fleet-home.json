   "options": {}
  },
  {
   "id": 7,
   "title": "Network",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "defenseclaw-prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (host_name, direction) (rate(system_network_io_bytes_total{device!~\"lo|veth.*|docker.*|br-.*|tailscale.*|cni.*|flannel.*\"}[5m]))",
     "legendFormat": "{{host_name}} {{direction}}",
     "datasource": {
      "type": "prometheus",
      "uid": "defenseclaw-prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "Log lines per host (5 min)",
