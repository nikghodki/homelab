   "gridPos": {
    "x": 12,
    "y": 27,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "loki",
    "uid": "defenseclaw-loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (host_name) (count_over_time({host_name=~\".+\"}[5m]))",
