      "targets": [
        {
          "refId": "A",
          "expr": "sum by (fleet_host) (count_over_time({host_name=~\".+\"} |= \"cisco-aibom\" | json syslog=\"SYSLOG_IDENTIFIER\", msg=\"MESSAGE\" | syslog=\"cisco-aibom\" | line_format \"{{.msg}}\" | json event=\"event\", target=\"target\", type=\"type\", name=\"name\", file=\"file\" | event=\"aibom.removed\" [24h]))",
          "datasource": {
