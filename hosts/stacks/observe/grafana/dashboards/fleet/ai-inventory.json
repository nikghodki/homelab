              "Value": "Removed"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "title": "Latest runs (counts per type and target, errors)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "defenseclaw-loki"
      },
      "description": "One line per host and night. counts: components per type; targets: per scanned dir or image.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host_name=~\".+\"} |= \"cisco-aibom\" | json syslog=\"SYSLOG_IDENTIFIER\", msg=\"MESSAGE\" | syslog=\"cisco-aibom\" | line_format \"{{.msg}}\" | json event=\"event\", total=\"total\", added=\"added\", removed=\"removed\" | event=\"aibom\"",
          "datasource": {
            "type": "loki",
            "uid": "defenseclaw-loki"
          },
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
